# IronLedger — Environment Configuration Template
# Copy this file to .env and fill in your values.
# .env is already in .gitignore and will NEVER be committed.
#
# NOTE: The app works fine without any of these set — it will run in
# memory-only mode with a local SHA-256 hash chain (no Supabase, no Ethereum).

# ── Supabase (Cloud Persistence) ────────────────────────────────────────────
# Get these from: https://app.supabase.com → Your Project → Settings → API
# Run supabase_schema.sql in the SQL Editor before first use.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key-here

# ── Ethereum Sepolia (On-Chain Anchoring) ────────────────────────────────────
# Alchemy / Infura Sepolia RPC endpoint
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Deployed contract type: ironledger (recommended) or evidencechain
CONTRACT_TYPE=ironledger

# Deployed EvidenceChain or IronLedger contract address on Sepolia
SEPOLIA_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS

# Your MetaMask wallet private key (with 0x prefix)
# MetaMask → Account icon → Account Details → Show private key → paste here
ANCHOR_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Etherscan API key — for contract verification (optional)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# ── Demo Mode ────────────────────────────────────────────────────────────────
# When true (default), attack/tamper simulation endpoints are enabled.
# Set to false in production to disable them.
DEMO_MODE=true

# ── HMAC Command Signing (Optional) ──────────────────────────────────────────
# When set, high-privilege ICS commands must include a valid HMAC-SHA256 signature.
# Leave blank to disable signature enforcement (suitable for local demo).
SCADA_HMAC_SECRET=
